{% set useSrcDoc = embedUrl is same as null and embedHtml is not same as null %}
{% set hasSize = width is not same as null and height is not same as null %}

<iframe
        allow="fullscreen" credentialless="true" csp="" referrerpolicy="same-origin"
        sandbox="allow-scripts {% if not useSrcDoc %}allow-same-origin{% endif %}"
        {% if hasSize %}
        width="{{ width }}" height="{{ height }}" style="border-width: 1px;"
        {% else %}
        width="100" height="100" style="border-width: 1px; width: 100%; height: fit-content;"
        {% endif %}
        title="{{ title }}"
        {% if useSrcDoc %}
        srcdoc="{{ embedHtml }}" src="{{ embedUrl }}"
        {% else %}
        src="{{ embedUrl ?? orgUrl }}"
        {% endif %}
></iframe>
