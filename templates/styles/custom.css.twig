{#
    using |raw here should be somewhat safe
    since the next thing you fight should be the browser's css parser
#}

{% if includeSiteStyles is same as true %}
/* site dynamic styles */
{{ include('components/_details_label.css.twig') }}
{% endif %}

{% if not app.user or not app.user.ignoreMagazinesCustomCss %}
{% if magazine is defined and magazine and magazine.customCss %}
/* magazine styles */
{% if magazine.customCss starts with 'https://' %}
/* remote CSS not included: {{ magazine.customCss|raw }} */
{% else %}
{{ magazine.customCss|raw }}
{% endif %}
{% endif %}
{% endif %}

{% if not app.user or not app.user.ignoreUserProfileCss %}
{% if profile is not same as null and profile.customPublicProfileCss is not same as null %}
/* {{ profile.username }} public profile styles */
{% if profile.customPublicProfileCss starts with 'https://' %}
/* remote CSS not included: {{ profile.customPublicProfileCss|raw }} */
{% else %}
{{ profile.customPublicProfileCss|raw }}
{% endif %}
{% endif %}
{% endif %}

{% if not app.user or not app.user.ignoreUserContentCss %}
{% for cssUser in cssUsers %}
{% if cssUser.customPublicContentCss is not same as null %}
/* {{ cssUser.username }} public content styles */
{% if cssUser.customPublicContentCss starts with 'https://' %}
/* remote CSS not included: {{ cssUser.customPublicContentCss|raw }} */
{% else %}
{{ cssUser.customPublicContentCss|raw }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}

{% if includeSiteStyles is same as true and app.user is defined and app.user and app.user.customCss %}
/* user styles */
{{ app.user.customCss|raw }}
{% endif %}
