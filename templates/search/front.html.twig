{% extends 'base.html.twig' %}

{%- block title -%}
    {{- 'search'|trans }} - {{ parent() -}}
{%- endblock -%}

{% block mainClass %}page-search page-settings{% endblock %}

{% block header_nav %}
{% endblock %}

{% block sidebar_top %}
{% endblock %}

{% block body %}
    <div class="page-search">
        <aside class="options options--top" id="options">
            <menu class="options__main">
                <li>
                    <a href="{{ url('search_general') }}"
                       class="{{ html_classes({'active': is_route_name('search_general')}) }}">
                        {{ 'content_and_users'|trans }}
                    </a>
                </li>
                <li>
                    <a href="{{ url('search_magazines') }}"
                       class="{{ html_classes({'active': is_route_name('search_magazines')}) }}">
                        {{ 'magazines'|trans }}
                    </a>
                </li>
                <li>
                    <a href="{{ url('search_hashtags') }}"
                       class="{{ html_classes({'active': is_route_name('search_hashtags')}) }}">
                        {{ 'hashtags'|trans }}
                    </a>
                </li>
            </menu>
        </aside>

        {% if is_route_name('search_magazines') %}
            {% include "search/magazine/fragment.html.twig" %}
        {% elseif is_route_name('search_hashtags') %}
            {% include "search/hashtag/fragment.html.twig" %}
        {% else %}
            {% include "search/general/fragment.html.twig" %}
        {% endif %}
    </div>
{% endblock %}
