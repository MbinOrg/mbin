<aside{{ attributes.defaults({class: 'domain__subscribe', 'data-controller': 'subs'}) }}>
    <div class="action"
        title="{{ hashtagSubscriptionCount ~ ' ' ~ 'subscribers_count'|trans({'%count%': hashtagSubscriptionCount}) }}"
        aria-label="{{ hashtagSubscriptionCount ~ ' ' ~ 'subscribers_count'|trans({'%count%': hashtagSubscriptionCount}) }}">
        <i class="fa-solid fa-users" aria-hidden="true"></i> <span>{{ hashtagSubscriptionCount }}</span>
    </div>
    <form action="{{ path('tag_' ~ (isHashtagSubscribed ? 'unsubscribe' : 'subscribe'), {name: hashtag.tag}) }}"
          name="domain_subscribe"
          method="post">
        <button type="submit"
                class="{{ html_classes('btn btn__secondary', {'active': isHashtagSubscribed}) }}"
                data-action="subs#send">
            {{ isHashtagSubscribed ? 'unsubscribe'|trans : 'subscribe'|trans }}
        </button>
    </form>

    <form action="{{ path('tag_' ~ (isHashtagBlocked ? 'unblock' : 'block'), {name: hashtag.tag}) }}"
          name="hashtag_block"
          method="post">
        <button type="submit"
                class="{{ html_classes('btn btn__secondary', {'active danger': isHashtagBlocked}) }}"
                data-action="subs#send">
            <i class="fa-solid fa-ban" aria-hidden="true"></i><span>{{ isHashtagBlocked ? 'unblock'|trans : 'block'|trans  }}</span>
        </button>
    </form>
</aside>
